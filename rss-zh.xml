    <item>
      <title>索尼诉考克斯案判决被推翻</title>
      <link>https://supreme.justia.com/cases/federal/us/607/24-171/</link>
      <guid isPermaLink="true">https://supreme.justia.com/cases/federal/us/607/24-171/</guid>
