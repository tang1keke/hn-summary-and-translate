&lt;div style="margin: 10px 0; padding: 10px; background: #f6f6f6; border-left: 3px solid #ff6600;"&gt;&lt;p style="margin: 0 0 5px 0;"&gt;&lt;strong&gt;m463:&lt;/strong&gt;&lt;/p&gt;&lt;p style="margin: 0;"&gt;反分裂主义&lt;p&gt;超级加州主义expialadocious&lt;/p&gt;&lt;/div&gt;
